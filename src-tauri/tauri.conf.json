{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BabyFlix",
  "version": "1.0.2",
  "identifier": "com.babyflix.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BabyFlix",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Entertainment",
    "publisher": "BabyFlix",
    "copyright": "© 2026 BabyFlix",
    "shortDescription": "Plex-like IPTV streaming player",
    "longDescription": "BabyFlix is a Plex-like desktop player for your own authorized IPTV access (Xtream Codes API or M3U playlist) with automatic posters and key-free IMDb ratings.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/slomo-b/babyflix/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2MjI3NzlGRUY3OTIwMDcKUldRSElIbnZuM2NpbHNXWjJVZDVUWGpEVXluRXZEa3NNdjIvWWdmaDlBbkNheWlTbG51T2RyNE4K"
    }
  }
}
